# Copy this file to .env and fill in your values.
# Stripe (test mode): dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Monthly subscription Price IDs. Create Products + recurring monthly Prices
# in your Stripe dashboard (Ultimate: 2300 = $23, Teams: 1900 = $19/user) and
# paste each Price ID here.
STRIPE_PRICE_ULTIMATE=price_xxx
STRIPE_PRICE_TEAMS=price_xxx
# Webhook signing secret. Add a webhook endpoint -> https://YOUR_HOST/stripe/webhook
# (events: checkout.session.completed, customer.subscription.deleted) and paste
# its whsec_... here. Optional — the Checkout success page also activates a plan.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Set "1" to enable real billing; auto-enabled when STRIPE_SECRET_KEY is set.
STRIPE_ENABLED=1
